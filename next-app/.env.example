# MongoDB connection string (Atlas cluster recommended for production)
MONGODB_URI=mongodb://localhost:27017/grievance_management

# JWT secrets (min 32 chars) and expiry
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Public URLs (used for reset/invitation email links)
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# SMTP (optional — in development, reset/invite tokens are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@grievance.local

# Bootstrap system admin (optional)
# If set and no SUPER_ADMIN exists yet, the first DB connection creates one.
# Password must be 8+ chars with upper case, lower case, and a number.
# Remove ADMIN_PASSWORD (and ADMIN_EMAIL) from your environment after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=