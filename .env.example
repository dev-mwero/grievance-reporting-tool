NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/grievance_management
JWT_ACCESS_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-string-at-least-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
MAX_FILES=5
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Production / cPanel ────────────────────────────────────────────────────
# For cPanel deployment, set these instead of the defaults above.
# NODE_ENV=production
# PORT=3000
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/grievance_management
# JWT_ACCESS_SECRET=<strong-random-string-at-least-32-chars>
# JWT_REFRESH_SECRET=<another-strong-random-string-at-least-32-chars>
# CORS_ORIGIN=https://your-domain.com
# APP_URL=https://your-domain.com
# CLIENT_URL=https://your-domain.com
# UPLOAD_DIR=/absolute/path/to/uploads
# CLIENT_DIST_DIR=public   # optional; defaults to <bundle>/public
